# Copy this file to .env.local for local development. Never commit real values.

# --- Website (Next.js / Vercel) ---------------------------------------------
# Your Convex deployment's URL, e.g. https://happy-animal-123.convex.cloud
NEXT_PUBLIC_CONVEX_URL=

# Used by `npx convex dev` / `npx convex deploy`. Filled in automatically by `npx convex dev`.
CONVEX_DEPLOYMENT=
# CONVEX_DEPLOY_KEY=

# --- Set on the Convex deployment (dashboard -> Settings -> Environment
# Variables, or `npx convex env set NAME value`), NOT in this file ----------
# SITE_URL                  The website address, e.g. http://localhost:3000
# JWT_PRIVATE_KEY, JWKS     Login signing keys. Generate with: npx @convex-dev/auth
# FIRST_ADMIN_PHONE         Optional: the first admin's mobile number, for `npx convex run setup:createFirstAdmin`
# FIRST_ADMIN_PASSWORD      Optional: their password (remove it once the admin exists)
# FIRST_ADMIN_NAME          Optional: their name
# STAFF_ALLOW_DEV_SEED      "true" ONLY on a development deployment, to allow sample data
# DEV_SEED_PASSWORD         Password given to the sample accounts (development only)
